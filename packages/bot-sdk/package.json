{
  "name": "@ai-chat/bot-sdk",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./plugins/bot/client": "./plugins/bot/client/index.ts",
    "./plugins/computer/e2b": "./plugins/computer/e2b/index.ts",
    "./plugins/channel/client": "./plugins/channel/client/index.ts",
    "./plugins/channel/fake": "./plugins/channel/fake/index.ts",
    "./plugins/channel/mailpit": "./plugins/channel/mailpit/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "eval:bot-memory": "node --import ./eval/memory/register-ts.mjs eval/memory/bot-run.ts",
    "eval:turn": "node --import ./eval/memory/register-ts.mjs eval/turn/run.ts",
    "eval:context": "node --import ./eval/memory/register-ts.mjs eval/turn/context.ts",
    "eval:ladder": "node --import ./eval/memory/register-ts.mjs eval/turn/ladder.ts",
    "eval:safety": "node --import ./eval/memory/register-ts.mjs eval/safety/run.ts",
    "eval:computer": "node --import ./eval/memory/register-ts.mjs eval/computer/run.ts",
    "eval:computer:helper": "node --import ./eval/memory/register-ts.mjs eval/computer/helper.ts",
    "eval:computer:lifecycle": "node --import ./eval/memory/register-ts.mjs eval/computer/lifecycle.ts",
    "eval:skills": "node --import ./eval/memory/register-ts.mjs eval/skills/run.ts",
    "eval:knowledge": "node --import ./eval/memory/register-ts.mjs eval/knowledge/run.ts",
    "eval:channels": "node --import ./eval/memory/register-ts.mjs eval/channels/run.ts",
    "eval:connectors": "node --import ./eval/memory/register-ts.mjs eval/connectors/run.ts",
    "eval:files": "node --import ./eval/memory/register-ts.mjs eval/files/run.ts",
    "eval:images": "node --import ./eval/memory/register-ts.mjs eval/images/run.ts",
    "eval:skills:draft": "node --import ./eval/memory/register-ts.mjs eval/skills/draft-run.ts",
    "eval:skills:record": "node --import ./eval/memory/register-ts.mjs eval/skills/record-fixtures.ts",
    "db:generate": "node scripts/migration-parts.ts"
  },
  "dependencies": {

# Copy to .env (gitignored) or set these in the environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai-chat_example
# Auth.js: any long random string. `openssl rand -base64 32`
AUTH_SECRET=change-me
# Trust the Host header (local dev, or behind a proxy that sets it).
AUTH_TRUST_HOST=true
# Chat SDK: encrypts Provider and Tool credentials at rest. Keep it stable (ADR 0003).
KEY_ENCRYPTION_SECRET=change-me-too
# Computers (optional, spec #519): set all three or none. Self-hosted E2B, see packages/bot-sdk/README.md.
# E2B_API_KEY=
# E2B_API_URL=http://localhost:3000
# E2B_SANDBOX_URL=http://localhost:3002

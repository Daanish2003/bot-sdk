{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "serve": "vite preview",
    "test:e2e": "playwright test",
    "dev": "vite dev",
    "check-types": "node scripts/generate-route-tree.ts && tsc --noEmit",
    "env:generate": "varlock codegen",
    "db:migrate": "varlock run -- node scripts/migrate.ts",
    "admin:grant": "varlock run -- node scripts/admin-role.ts grant",
    "admin:revoke": "varlock run -- node scripts/admin-role.ts revoke",
    "db:rotate-keys": "varlock run -- node scripts/rotate-keys.ts",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },

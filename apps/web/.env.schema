# @defaultRequired=true
# @defaultSensitive=true
# Every value is read at run time, none inlined by the build: the Docker image is built once with
# placeholders (apps/web/Dockerfile) and configured by its environment where it runs.
# @defaultDynamic=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The public origin of the app. Not a secret: it appears in every verification link, so Varlock's
# leak check must not treat it as one (it would turn the mailbox route's responses into 500s).
# @type=url
# @sensitive=false
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Encrypts users' Provider and Tool credentials at rest (ADR 0010). The newest key: it encrypts.
# Fixed in tests. Generate one with: openssl rand -base64 32
# @type=string(minLength=32)
KEY_ENCRYPTION_SECRET=if(forEnv(test), test-key-encryption-secret-not-for-production)

# The key before KEY_ENCRYPTION_SECRET, kept while rotating (ADR 0010): it still decrypts stored
# credentials but encrypts none. Leave it unset unless rotating.
# @type=string(minLength=32)
# @required=false
KEY_ENCRYPTION_SECRET_PREVIOUS=

# Sends the auth emails (verification, and the rest as they land). In production it is Resend, so
# its key is required there and optional elsewhere.
# @type=string(minLength=1)
# @required=forEnv(production)
RESEND_API_KEY=

# The From address of every email, e.g. "AI Chat <no-reply@example.com>". Required in production.
# @type=string(minLength=1)
# @required=forEnv(production)
EMAIL_FROM=

# OAuth client ids and secrets for "Continue with GitHub" and "Continue with Google" (the callback
# is <BETTER_AUTH_URL>/api/auth/callback/<provider>). Required in production; in development the
# buttons fail until they are set.
# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
GITHUB_CLIENT_ID=

# @type=string(minLength=1)
# @required=forEnv(production)
GITHUB_CLIENT_SECRET=

# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
# @required=forEnv(production)
GOOGLE_CLIENT_SECRET=

# "Connect ChatGPT" (linking a ChatGPT plan as OpenAI Provider credentials, ADR 0023). The link is
# registered only when both are set. The client id is the public PKCE client the dynamic ChatGPT
# sign-in registered, and the host id is the `ext_agent_host_id` it was registered under (both are
# public: there is no client secret). ChatGPT redirects to <BETTER_AUTH_URL>/auth/callback with
# localhost swapped for 127.0.0.1, and that route bounces back to BETTER_AUTH_URL.
# @type=string(minLength=1)
# @required=false
# @sensitive=false
CHATGPT_CLIENT_ID=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
CHATGPT_HOST_ID=

# The app's name in emails and their subjects. Required in production. Public: it is printed in
# every email, so the leak check must not scan for it.
# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
APP_NAME=

# Which sender delivers the mail. Unset: Resend in production, the console (logs the link and
# writes the HTML) elsewhere. `capture` keeps messages in memory for the end-to-end tests, behind
# the test-only mailbox route, and needs a localhost BETTER_AUTH_URL.
# @type=enum(console, resend, capture)
# @required=false
EMAIL_TRANSPORT=

# Test-only: hosts the `fetch_url` tool may read past the SSRF guard, plain HTTP included, as a
# comma-separated list of `host` or `host:port`. The end-to-end tests serve their fake page on
# localhost. It needs a localhost BETTER_AUTH_URL, so the app refuses it anywhere else.
# Not a secret: a host list, so Varlock's leak check must not scan responses for it.
# @type=string
# @required=false
# @sensitive=false
SSRF_ALLOW_HOSTS=

# The one remote MCP server users can connect to (spec #91). Set all five or none: with none, users
# see no Connections section and no MCP tools. The URL is the server's Streamable HTTP endpoint, HTTPS
# only. The key names the server in storage and in its tools ("<key>_<tool>"): letters, digits, "_"
# and "-". The OAuth client is one the Host registered with the server ahead of time (no Dynamic
# Client Registration), and its redirect URI is <BETTER_AUTH_URL>/api/chat/mcp/callback.
# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_KEY=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_NAME=

# @type=url
# @required=false
# @sensitive=false
MCP_SERVER_URL=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_OAUTH_CLIENT_ID=

# @type=string(minLength=1)
# @required=false
MCP_SERVER_OAUTH_CLIENT_SECRET=

# The request headers the client's IP is read from, for rate limits, in order, comma-separated (e.g.
# "cf-connecting-ip" on Cloudflare). Unset, Better Auth reads x-forwarded-for. Production must run
# behind a proxy that sets the header named here: otherwise no client IP is found, and every client
# shares one rate-limit bucket (keyed no-trusted-ip|<path>). Only name headers your proxy sets, since
# a client can send any header.
# @type=string
# @required=false
# @sensitive=false
TRUSTED_IP_HEADERS=

# Shares Runs between processes (ADR 0006). Set it when more than one process serves the app, a
# zero-downtime deploy included. Unset, the app runs on the in-memory runtime.
# @type=url
# @required=false
REDIS_URL=

# The Bots' Computer, on self-hosted E2B (spec #519). Set E2B_API_KEY, E2B_API_URL and E2B_SANDBOX_URL
# together or none; unset, Bots run without a Computer. See packages/bot-sdk/README.md for the local
# E2B Embed and for building the template.
# @type=string(minLength=1)
# @required=false
E2B_API_KEY=

# @type=url
# @required=false
E2B_API_URL=

# @type=url
# @required=false
E2B_SANDBOX_URL=

# The Host's own Models, paid for with the Host's Provider credentials (ADR 0007). Set
# HOST_PROVIDER, HOST_CREDENTIALS and HOST_MODELS together or none. HOST_PROVIDER is a Provider id
# (e.g. anthropic, openai, ollama). HOST_CREDENTIALS is that Provider's credentials as JSON (e.g.
# {"apiKey":"..."}, or {"host":"http://localhost:11434"} for Ollama). They are never stored.
# HOST_MODELS is a JSON array of Models, each with modelId, maxOutputTokens (required), and the
# price per 1M tokens: inputUsdPerMillion and outputUsdPerMillion (optional label, images, pdfs,
# tools). Optional cacheReadUsdPerMillion and cacheWriteUsdPerMillion price input read from and
# written to the Provider's prompt cache; unset, cached input costs the input price. On Anthropic,
# writes cost 2x input (1-hour cache) and reads 0.1x. Unset, users see only the Models of their own
# keys.
# @type=string
# @required=false
# @sensitive=false
HOST_PROVIDER=

# @type=string
# @required=false
HOST_CREDENTIALS=

# @type=string
# @required=false
# @sensitive=false
HOST_MODELS=

# The Quota each user has on the Host's Models, in US dollars (ADR 0007). Unset, it is unlimited.
# A user's own keys are never counted. The Quota resets at the start of each UTC day (the default)
# or calendar month, set by HOST_QUOTA_WINDOW (day or month).
# @type=string
# @required=false
# @sensitive=false
HOST_QUOTA_BUDGET_USD=

# @type=enum(day, month)
# @required=false
# @sensitive=false
HOST_QUOTA_WINDOW=

# The Host's own Image Models, for Generated images (spec #278), paid for per image. Set
# HOST_IMAGE_PROVIDER, HOST_IMAGE_CREDENTIALS and HOST_IMAGE_MODELS together or none.
# HOST_IMAGE_PROVIDER is a Provider id (e.g. openai, gemini). HOST_IMAGE_CREDENTIALS is that
# Provider's credentials as JSON (e.g. {"apiKey":"..."}). They are never stored. HOST_IMAGE_MODELS is
# a JSON array of Image Models, each with modelId, size, quality, pricePerImageUsd (required, in US
# dollars per image) and optionally imageInputPerMTok, imageOutputPerMTok and textInputPerMTok.
# Unset, the Host offers no Image Models.
# @type=string
# @required=false
# @sensitive=false
HOST_IMAGE_PROVIDER=

# @type=string
# @required=false
HOST_IMAGE_CREDENTIALS=

# @type=string
# @required=false
# @sensitive=false
HOST_IMAGE_MODELS=

# The Host's default Image Model: a Model of HOST_IMAGE_MODELS as provider:model (e.g.
# openai:gpt-image-1-mini). Image generation uses it when a user picks none. Unset, users who pick
# none get no images.
# @type=string
# @required=false
# @sensitive=false
HOST_DEFAULT_IMAGE_MODEL=

# Where users' files go (ADR 0015). Set all five or none: with none, file bytes stay in Postgres. The
# store is any S3-compatible bucket, Cloudflare R2 in production and RustFS locally (docker compose).
# The bucket must already exist; the app never creates it. S3_ENDPOINT is the store's origin. Switching
# a running deployment from one store to the other isn't supported.
# @type=url
# @required=false
# @sensitive=false
S3_ENDPOINT=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
S3_BUCKET=

# The signing region: "auto" for R2; any name the store was started with for RustFS.
# @type=string(minLength=1)
# @required=false
# @sensitive=false
S3_REGION=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
S3_ACCESS_KEY_ID=

# @type=string(minLength=1)
# @required=false
S3_SECRET_ACCESS_KEY=

# The email Channel (spec #761). Unset, POST /api/chat/channels/email refuses every mail and nothing is
# sent out. Set MAILPIT_API_URL (Mailpit's REST API origin, such as http://localhost:8025;
# `docker compose up -d mailpit`) and the Bots mail through Mailpit: its received-message webhook
# (MP_WEBHOOK_URL, set in docker-compose.yml) POSTs to /api/chat/channels/email. Mailpit gives no
# SPF/DKIM/DMARC verdict, so the adapter vouches for every mail it holds: use it only on localhost.
# @type=url
# @required=false
# @sensitive=false
MAILPIT_API_URL=

# The domain the Bots' addresses are on (name@<domain>), which Mailpit accepts mail for.
# @type=string(minLength=1)
# @required=false
# @sensitive=false
EMAIL_CHANNEL_DOMAIN=bots.localhost
